{
  "name": "autoclick",
  "version": "0.1.0",
  "description": "Minimalist auto clicker UI (Electron + React + Vite)",
  "main": "dist-electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --check .",
    "test:renderer": "vitest run --config vitest.config.mts --environment jsdom",
    "test:main": "jest --config jest.config.cjs",
    "test:e2e": "playwright test",
    "release:hash": "bash scripts/verify-release.sh"
  },
  "dependencies": {
    "@nut-tree/nut-js": "^3.0.1",
    "framer-motion": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "c8": "^9.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "@playwright/test": "^1.44.1",
    "jsdom": "^24.1.0",
    "playwright": "^1.44.1",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "electron": "^28.3.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.2.10",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
